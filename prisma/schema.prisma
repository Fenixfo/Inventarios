// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Schema: beraca

model Usuario {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique
  lastLogin DateTime? @map("last_login") @db.Timestamptz

  // Relations
  // El acceso y los permisos viven en UsuarioTienda: son por tienda, así
  // que la misma persona puede ser administradora en una y vendedora en
  // otra. El modelo de roles globales que había antes se retiró.
  tiendas   UsuarioTienda[]
  solicitudesAcceso SolicitudAcceso[]
  productosCreados Producto[]
  clientesCreados Cliente[]
  facturasCreadas Factura[]
  abonos    Abono[]
  movimientosInventario InventarioMovimiento[]
  auditoria Auditoria[]
  configuracionesActualizadas Configuracion[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("usuarios")
}

model Tienda {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// El nombre no es único: dos dueños distintos pueden tener negocios que
  /// se llamen igual, y se distinguen por su código.
  nombre      String   @db.VarChar(255)

  /// Código de 6 caracteres que el dueño comparte para que le pidan acceso.
  /// Sustituye al directorio de tiendas: sin el código no se puede solicitar
  /// entrar, así que no hace falta publicar la lista de negocios.
  codigo      String   @unique @db.VarChar(6)

  /// Desde qué IP se creó. Sirve para frenar a quien abra tiendas en serie
  /// sin castigar a quien comparte conexión: el tope es por día, no total.
  creadaDesdeIp String? @map("creada_desde_ip") @db.VarChar(45)

  /// Si sus productos salen en el catálogo público. Lo decide el dueño:
  /// hay quien quiere vitrina y quien usa esto solo para su inventario.
  publica     Boolean  @default(true)
  descripcion String?  @db.Text
  ciudad      String?  @db.VarChar(100)
  pais        String?  @default("Colombia") @db.VarChar(100)
  activo      Boolean  @default(true)

  // Relations
  usuarios    UsuarioTienda[]
  solicitudesAcceso SolicitudAcceso[]
  productos   Producto[]
  clientes    Cliente[]
  facturas    Factura[]
  auditoria   Auditoria[]
  configuracion Configuracion[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("tiendas")
}

model UsuarioTienda {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  tiendaId  String   @map("tienda_id") @db.Uuid

  /// Quien creó la tienda. Puede todo y nadie se lo puede retirar.
  esOwner   Boolean  @default(false) @map("es_owner")

  /// Nombrado por el owner. Tiene los mismos permisos efectivos, pero no
  /// puede tocar al owner y el owner sí puede retirarle el cargo.
  esAdmin   Boolean  @default(false) @map("es_admin")

  // Relations
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tienda    Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  permisos  PermisoAsignado[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([usuarioId, tiendaId])
  @@index([tiendaId])
  @@map("usuarios_tiendas")
}

model SolicitudAcceso {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  usuarioId String   @map("usuario_id") @db.Uuid
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  tiendaId  String   @map("tienda_id") @db.Uuid
  tienda    Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  email     String   @db.VarChar(255)
  razon     String?  @db.Text

  // Estado: pendiente, aprobado, rechazado
  estado    String   @default("pendiente") @db.VarChar(50)

  // Quien aprobó/rechazó
  respondidoPor String? @map("respondido_por") @db.Uuid
  respondidoEn DateTime? @map("respondido_en") @db.Timestamptz
  comentarioAdmin String? @map("comentario_admin") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([usuarioId, tiendaId])
  @@index([estado])
  @@index([tiendaId])
  @@map("solicitudes_acceso")
}

// FUTURE: Sistema de Roles y Permisos (pendiente de implementación)
// Estos modelos están listos para cuando se quiera implementar un sistema granular de permisos

/// Catálogo de lo que se puede hacer, como par módulo + acción.
/// El módulo por sí solo da "ver"; el resto de acciones se asignan aparte.
model Permiso {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  modulo      String   @db.VarChar(50)   // productos, inventario, clientes, facturas...
  accion      String   @db.VarChar(50)   // ver, crear, editar, anular, ver_todas...
  nombre      String   @db.VarChar(120)  // etiqueta para la interfaz
  descripcion String?  @db.Text
  orden       Int      @default(0)

  asignaciones PermisoAsignado[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([modulo, accion])
  @@index([modulo])
  @@map("permisos")
}

/// Un permiso concedido a alguien dentro de una tienda concreta. Cuelga de
/// la relación usuario–tienda, no del usuario: la misma persona puede ser
/// administradora en una tienda y vendedora en otra.
model PermisoAsignado {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioTiendaId String   @map("usuario_tienda_id") @db.Uuid
  permisoId       String   @map("permiso_id") @db.Uuid

  usuarioTienda   UsuarioTienda @relation(fields: [usuarioTiendaId], references: [id], onDelete: Cascade)
  permiso         Permiso       @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  asignadoPor String?  @map("asignado_por") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([usuarioTiendaId, permisoId])
  @@index([usuarioTiendaId])
  @@map("permisos_asignados")
}

model Producto {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Único dentro de la tienda, no en toda la base: cada negocio numera sus
  /// productos como quiera y dos tiendas distintas pueden usar el mismo SKU.
  sku       String   @db.VarChar(100)

  /// El nombre en minúsculas y sin tildes, para buscar. La calcula Postgres
  /// sola (columna generada): nunca se escribe desde aquí, y por eso no
  /// aparece en ningún `create` ni `update`.
  nombreBusqueda String? @map("nombre_busqueda")
  nombre    String   @db.VarChar(255)
  categoria String   @db.VarChar(100)

  // Características
  dimensiones String?   @db.VarChar(50)
  color       String?   @db.VarChar(100)
  acabado     String?   @db.VarChar(100)
  espesorMm   Decimal?  @map("espesor_mm") @db.Decimal(4, 2)
  m2PorCaja   Decimal?  @map("m2_por_caja") @db.Decimal(6, 2)

  // Precios
  /// Precio al público: es el que ve el cliente en el catálogo.
  precioUnitario        Decimal   @map("precio_unitario") @db.Decimal(10, 2)
  precioUnitarioUpdatedAt DateTime? @map("precio_unitario_updated_at") @db.Timestamptz

  /// Precio a bodega o mayorista. Anulable a propósito: sin él se cobra el
  /// precio al público, en vez de vender a cero.
  precioBodega          Decimal?  @map("precio_bodega") @db.Decimal(10, 2)
  precioBodegaUpdatedAt DateTime? @map("precio_bodega_updated_at") @db.Timestamptz

  /// Precio de compra.
  costo                 Decimal?  @db.Decimal(10, 2)
  costoUpdatedAt        DateTime? @map("costo_updated_at") @db.Timestamptz

  // Inventario
  stockActual   Decimal @default(0) @map("stock_actual") @db.Decimal(12, 2)
  stockMinimo   Decimal @default(0) @map("stock_minimo") @db.Decimal(12, 2)

  // Metadata
  proveedor     String?   @db.VarChar(255)
  descripcion   String?   @db.Text
  imagenUrl     String?   @map("imagen_url") @db.VarChar(500)

  // Estado
  activo        Boolean   @default(true)
  activoDesde   DateTime  @default(now()) @map("activo_desde") @db.Timestamptz

  tiendaId  String?   @map("tienda_id") @db.Uuid
  tienda    Tienda?   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  createdBy     String?   @map("created_by") @db.Uuid
  createdByUser Usuario?  @relation(fields: [createdBy], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  facturasItems FacturaItem[]
  movimientosInventario InventarioMovimiento[]

  @@unique([tiendaId, sku], map: "productos_tienda_sku_key")
  @@index([sku])
  @@index([stockActual])
  @@index([activo])
  @@map("productos")
}

model Cliente {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre    String   @db.VarChar(255)
  email     String?  @db.VarChar(255)
  telefono  String?  @db.VarChar(20)
  /// Única dentro de la tienda: la misma persona puede ser cliente de dos
  /// negocios distintos, y cada uno la registra por su cuenta.
  cedulaCc  String?  @map("cedula_cc") @db.VarChar(50)
  direccion String?  @db.Text

  // Términos de pago
  terminoPago String?   @map("termino_pago") @db.VarChar(50)
  limiteCredito Decimal @default(0) @map("limite_credito") @db.Decimal(12, 2)
  ultimaCompraFecha DateTime? @map("ultima_compra_fecha") @db.Timestamptz

  // Estado
  activo      Boolean   @default(true)
  activoDesde DateTime  @default(now()) @map("activo_desde") @db.Timestamptz

  tiendaId  String?   @map("tienda_id") @db.Uuid
  tienda    Tienda?   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  createdBy   String?   @map("created_by") @db.Uuid
  createdByUser Usuario?  @relation(fields: [createdBy], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  facturas  Factura[]

  @@unique([tiendaId, cedulaCc], map: "clientes_tienda_cedula_key")
  @@index([cedulaCc])
  @@index([email])
  @@map("clientes")
}

model Factura {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Único dentro de la tienda, no en toda la base: cada negocio lleva su
  /// propia numeración y dos tiendas pueden emitir el mismo número el mismo
  /// día.
  numeroFactura   String   @map("numero_factura") @db.VarChar(50)

  clienteId       String?  @map("cliente_id") @db.Uuid
  cliente         Cliente? @relation(fields: [clienteId], references: [id])

  tiendaId        String?  @map("tienda_id") @db.Uuid
  tienda          Tienda?  @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  usuarioId       String?  @map("usuario_id") @db.Uuid
  usuario         Usuario? @relation(fields: [usuarioId], references: [id])

  // Fechas
  fecha           DateTime @default(now()) @db.Timestamptz
  fechaPago       DateTime? @map("fecha_pago") @db.Timestamptz
  fechaVencimiento DateTime? @map("fecha_vencimiento") @db.Timestamptz
  fechaAnulacion  DateTime? @map("fecha_anulacion") @db.Timestamptz

  // Términos
  terminoPago String?   @map("termino_pago") @db.VarChar(50)
  metodoPago  String?   @map("metodo_pago") @db.VarChar(50)

  // Montos
  anticipo    Decimal @default(0) @db.Decimal(12, 2)
  contraEntrega Decimal @default(0) @map("contra_entrega") @db.Decimal(12, 2)
  subtotal    Decimal @db.Decimal(12, 2)
  descuentoPorcentaje Decimal @default(0) @map("descuento_porcentaje") @db.Decimal(5, 2)
  descuentoMonto Decimal @default(0) @map("descuento_monto") @db.Decimal(12, 2)
  impuesto    Decimal @default(0) @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  // Estado
  estado      String   @default("pendiente") @db.VarChar(50)
  observaciones String? @db.Text

  /// Se facturó a precio de bodega. Queda guardado para poder explicar
  /// después por qué dos facturas del mismo producto valen distinto.
  esBodega    Boolean  @default(false) @map("es_bodega")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  items       FacturaItem[]
  abonos      Abono[]

  @@unique([tiendaId, numeroFactura], map: "facturas_tienda_numero_key")
  @@index([numeroFactura])
  @@index([clienteId])
  @@index([estado])
  @@index([fecha])
  @@index([usuarioId])
  @@map("facturas")
}

model Abono {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  facturaId   String   @map("factura_id") @db.Uuid
  factura     Factura  @relation(fields: [facturaId], references: [id], onDelete: Cascade)

  usuarioId   String?  @map("usuario_id") @db.Uuid
  usuario     Usuario? @relation(fields: [usuarioId], references: [id])

  monto       Decimal  @db.Decimal(12, 2)
  fecha       DateTime @default(now()) @db.Timestamptz

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([facturaId])
  @@index([fecha])
  @@index([usuarioId])
  @@map("abonos")
}

model FacturaItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  facturaId   String   @map("factura_id") @db.Uuid
  factura     Factura  @relation(fields: [facturaId], references: [id], onDelete: Cascade)

  productoId  String?  @map("producto_id") @db.Uuid
  producto    Producto? @relation(fields: [productoId], references: [id], onDelete: SetNull)

  productoNombre String? @map("producto_nombre") @db.VarChar(255)
  cantidadM2  Decimal  @map("cantidad_m2") @db.Decimal(12, 2)
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(10, 2)
  subtotal    Decimal  @db.Decimal(12, 2)

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([facturaId])
  @@index([productoId])
  @@map("facturas_items")
}

model InventarioMovimiento {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  productoId  String   @map("producto_id") @db.Uuid
  producto    Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  tipo        String   @db.VarChar(50)
  cantidad    Decimal  @db.Decimal(12, 2)
  stockAntes  Decimal  @map("stock_antes") @db.Decimal(12, 2)
  stockDespues Decimal @map("stock_despues") @db.Decimal(12, 2)

  referenciaTipo String? @map("referencia_tipo") @db.VarChar(50)
  referenciaId   String? @map("referencia_id") @db.Uuid
  motivo       String?  @db.Text

  usuarioId    String?  @map("usuario_id") @db.Uuid
  usuario      Usuario? @relation(fields: [usuarioId], references: [id])

  ipAddress   String?  @map("ip_address") @db.Inet
  fechaMovimiento DateTime @default(now()) @map("fecha_movimiento") @db.Timestamptz

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([productoId])
  @@index([tipo])
  @@index([fechaMovimiento])
  @@index([usuarioId])
  @@map("inventario_movimientos")
}

model Auditoria {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  usuarioId   String?  @map("usuario_id") @db.Uuid
  usuario     Usuario? @relation(fields: [usuarioId], references: [id])

  /// En qué tienda ocurrió. Sin esto, quien puede ver la auditoría vería
  /// también los movimientos de los demás negocios.
  tiendaId    String?  @map("tienda_id") @db.Uuid
  tienda      Tienda?  @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  tablaAfectada String @map("tabla_afectada") @db.VarChar(100)
  registroId    String @map("registro_id") @db.Uuid
  accion        String @db.VarChar(50)

  datosAntes    Json?  @map("datos_antes") @db.JsonB
  datosDespues  Json?  @map("datos_despues") @db.JsonB

  ipAddress     String? @map("ip_address") @db.Inet
  userAgent     String? @map("user_agent") @db.Text

  fechaAccion   DateTime @default(now()) @map("fecha_accion") @db.Timestamptz
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tablaAfectada])
  @@index([usuarioId])
  @@index([fechaAccion])
  @@index([accion])
  @@map("auditoria")
}

model Configuracion {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Cada tienda tiene su propia configuración: su logo, su NIT, su
  /// WhatsApp. Antes había una sola fila por clave para todo el sistema.
  tiendaId  String   @map("tienda_id") @db.Uuid
  tienda    Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  clave     String   @db.VarChar(100)
  valor     String?  @db.VarChar(500)
  tipo      String?  @db.VarChar(50)

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedByUser Usuario? @relation(fields: [updatedBy], references: [id])

  @@unique([tiendaId, clave])
  @@map("configuracion")
}
