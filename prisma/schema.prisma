// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Schema: beraca

model Usuario {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique
  lastLogin DateTime? @map("last_login") @db.Timestamptz

  // Relations
  roles     UsuarioRol[]
  rolesDetallados UsuarioRolDetallado[] @relation("UsuarioRolDetallado")
  tiendas   UsuarioTienda[]
  solicitudesAcceso SolicitudAcceso[]
  productosCreados Producto[]
  clientesCreados Cliente[]
  facturasCreadas Factura[]
  abonos    Abono[]
  movimientosInventario InventarioMovimiento[]
  auditoria Auditoria[]
  configuracionesActualizadas Configuracion[]
  rolesPersonalizados UsuarioRolPersonalizado[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("usuarios")
}

model UsuarioRol {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  rol       String   @db.VarChar(50)

  // Relations
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([usuarioId, rol])
  @@map("usuarios_roles")
}

model RolPersonalizado {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre      String   @unique @db.VarChar(100)
  descripcion String?  @db.Text
  esAdmin     Boolean  @default(false) @map("es_admin")
  activo      Boolean  @default(true)

  // Relaciones
  permisos    PermisoRolPersonalizado[]
  usuarios    UsuarioRolPersonalizado[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("roles_personalizados")
}

model PermisoModulo {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  modulo    String   @unique @db.VarChar(50)
  nombre    String   @db.VarChar(100)
  descripcion String? @db.Text
  icono     String?  @db.VarChar(20)

  // Relaciones
  permisos  PermisoRolPersonalizado[]

  @@map("permisos_modulos")
}

model PermisoRolPersonalizado {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rolId       String @map("rol_id") @db.Uuid
  moduloId    String @map("modulo_id") @db.Uuid

  // Relaciones
  rol         RolPersonalizado @relation(fields: [rolId], references: [id], onDelete: Cascade)
  modulo      PermisoModulo @relation(fields: [moduloId], references: [id], onDelete: Cascade)

  @@unique([rolId, moduloId])
  @@map("permisos_roles_personalizados")
}

model UsuarioRolPersonalizado {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  rolId     String   @map("rol_id") @db.Uuid

  // Relaciones
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol       RolPersonalizado @relation(fields: [rolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([usuarioId, rolId])
  @@map("usuarios_roles_personalizados")
}

model Tienda {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre      String   @unique @db.VarChar(255)
  descripcion String?  @db.Text
  ciudad      String?  @db.VarChar(100)
  pais        String?  @default("Colombia") @db.VarChar(100)
  activo      Boolean  @default(true)

  // Relations
  usuarios    UsuarioTienda[]
  solicitudesAcceso SolicitudAcceso[]
  productos   Producto[]
  clientes    Cliente[]
  facturas    Factura[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("tiendas")
}

model UsuarioTienda {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  tiendaId  String   @map("tienda_id") @db.Uuid

  // Relations
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tienda    Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([usuarioId, tiendaId])
  @@map("usuarios_tiendas")
}

model SolicitudAcceso {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  usuarioId String   @map("usuario_id") @db.Uuid
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  tiendaId  String   @map("tienda_id") @db.Uuid
  tienda    Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  email     String   @db.VarChar(255)
  razon     String?  @db.Text

  // Estado: pendiente, aprobado, rechazado
  estado    String   @default("pendiente") @db.VarChar(50)

  // Quien aprobó/rechazó
  respondidoPor String? @map("respondido_por") @db.Uuid
  respondidoEn DateTime? @map("respondido_en") @db.Timestamptz
  comentarioAdmin String? @map("comentario_admin") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([usuarioId, tiendaId])
  @@index([estado])
  @@index([tiendaId])
  @@map("solicitudes_acceso")
}

// FUTURE: Sistema de Roles y Permisos (pendiente de implementación)
// Estos modelos están listos para cuando se quiera implementar un sistema granular de permisos

model Rol {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre      String   @unique @db.VarChar(100)
  descripcion String?  @db.Text
  activo      Boolean  @default(true)

  // Relaciones
  permisos    RolPermiso[]
  usuariosRol UsuarioRolDetallado[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("roles")
}

model Permiso {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre      String   @unique @db.VarChar(100)
  descripcion String?  @db.Text
  recurso     String   @db.VarChar(50)  // facturas, clientes, productos, usuarios, etc.
  accion      String   @db.VarChar(50)  // ver, crear, editar, eliminar, etc.

  // Relaciones
  roles       RolPermiso[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([recurso, accion])
  @@map("permisos")
}

model RolPermiso {
  rolId      String @map("rol_id") @db.Uuid
  permisoId  String @map("permiso_id") @db.Uuid

  // Relaciones
  rol        Rol    @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso    Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@map("roles_permisos")
}

model UsuarioRolDetallado {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  rolId     String   @map("rol_id") @db.Uuid

  // Relaciones
  usuario   Usuario  @relation("UsuarioRolDetallado", fields: [usuarioId], references: [id], onDelete: Cascade)
  rol       Rol      @relation(fields: [rolId], references: [id], onDelete: Cascade)

  asignadoPor String? @map("asignado_por") @db.Uuid
  razon       String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([usuarioId, rolId])
  @@map("usuarios_roles_detallado")
}

model Producto {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku       String   @unique @db.VarChar(100)
  nombre    String   @db.VarChar(255)
  categoria String   @db.VarChar(100)

  // Características
  dimensiones String?   @db.VarChar(50)
  color       String?   @db.VarChar(100)
  acabado     String?   @db.VarChar(100)
  espesorMm   Decimal?  @map("espesor_mm") @db.Decimal(4, 2)
  m2PorCaja   Decimal?  @map("m2_por_caja") @db.Decimal(6, 2)

  // Precios
  precioUnitario        Decimal   @map("precio_unitario") @db.Decimal(10, 2)
  precioUnitarioUpdatedAt DateTime? @map("precio_unitario_updated_at") @db.Timestamptz
  costo                 Decimal?  @db.Decimal(10, 2)
  costoUpdatedAt        DateTime? @map("costo_updated_at") @db.Timestamptz

  // Inventario
  stockActual   Decimal @default(0) @map("stock_actual") @db.Decimal(12, 2)
  stockMinimo   Decimal @default(0) @map("stock_minimo") @db.Decimal(12, 2)

  // Metadata
  proveedor     String?   @db.VarChar(255)
  descripcion   String?   @db.Text
  imagenUrl     String?   @map("imagen_url") @db.VarChar(500)

  // Estado
  activo        Boolean   @default(true)
  activoDesde   DateTime  @default(now()) @map("activo_desde") @db.Timestamptz

  tiendaId  String?   @map("tienda_id") @db.Uuid
  tienda    Tienda?   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  createdBy     String?   @map("created_by") @db.Uuid
  createdByUser Usuario?  @relation(fields: [createdBy], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  facturasItems FacturaItem[]
  movimientosInventario InventarioMovimiento[]

  @@index([sku])
  @@index([stockActual])
  @@index([activo])
  @@map("productos")
}

model Cliente {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre    String   @db.VarChar(255)
  email     String?  @db.VarChar(255)
  telefono  String?  @db.VarChar(20)
  cedulaCc  String?  @unique @map("cedula_cc") @db.VarChar(50)
  direccion String?  @db.Text

  // Términos de pago
  terminoPago String?   @map("termino_pago") @db.VarChar(50)
  limiteCredito Decimal @default(0) @map("limite_credito") @db.Decimal(12, 2)
  ultimaCompraFecha DateTime? @map("ultima_compra_fecha") @db.Timestamptz

  // Estado
  activo      Boolean   @default(true)
  activoDesde DateTime  @default(now()) @map("activo_desde") @db.Timestamptz

  tiendaId  String?   @map("tienda_id") @db.Uuid
  tienda    Tienda?   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  createdBy   String?   @map("created_by") @db.Uuid
  createdByUser Usuario?  @relation(fields: [createdBy], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  facturas  Factura[]

  @@index([cedulaCc])
  @@index([email])
  @@map("clientes")
}

model Factura {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numeroFactura   String   @unique @map("numero_factura") @db.VarChar(50)

  clienteId       String?  @map("cliente_id") @db.Uuid
  cliente         Cliente? @relation(fields: [clienteId], references: [id])

  tiendaId        String?  @map("tienda_id") @db.Uuid
  tienda          Tienda?  @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  usuarioId       String?  @map("usuario_id") @db.Uuid
  usuario         Usuario? @relation(fields: [usuarioId], references: [id])

  // Fechas
  fecha           DateTime @default(now()) @db.Timestamptz
  fechaPago       DateTime? @map("fecha_pago") @db.Timestamptz
  fechaVencimiento DateTime? @map("fecha_vencimiento") @db.Timestamptz
  fechaAnulacion  DateTime? @map("fecha_anulacion") @db.Timestamptz

  // Términos
  terminoPago String?   @map("termino_pago") @db.VarChar(50)
  metodoPago  String?   @map("metodo_pago") @db.VarChar(50)

  // Montos
  anticipo    Decimal @default(0) @db.Decimal(12, 2)
  contraEntrega Decimal @default(0) @map("contra_entrega") @db.Decimal(12, 2)
  subtotal    Decimal @db.Decimal(12, 2)
  descuentoPorcentaje Decimal @default(0) @map("descuento_porcentaje") @db.Decimal(5, 2)
  descuentoMonto Decimal @default(0) @map("descuento_monto") @db.Decimal(12, 2)
  impuesto    Decimal @default(0) @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  // Estado
  estado      String   @default("pendiente") @db.VarChar(50)
  observaciones String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  items       FacturaItem[]
  abonos      Abono[]

  @@index([numeroFactura])
  @@index([clienteId])
  @@index([estado])
  @@index([fecha])
  @@index([usuarioId])
  @@map("facturas")
}

model Abono {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  facturaId   String   @map("factura_id") @db.Uuid
  factura     Factura  @relation(fields: [facturaId], references: [id], onDelete: Cascade)

  usuarioId   String?  @map("usuario_id") @db.Uuid
  usuario     Usuario? @relation(fields: [usuarioId], references: [id])

  monto       Decimal  @db.Decimal(12, 2)
  fecha       DateTime @default(now()) @db.Timestamptz

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([facturaId])
  @@index([fecha])
  @@index([usuarioId])
  @@map("abonos")
}

model FacturaItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  facturaId   String   @map("factura_id") @db.Uuid
  factura     Factura  @relation(fields: [facturaId], references: [id], onDelete: Cascade)

  productoId  String?  @map("producto_id") @db.Uuid
  producto    Producto? @relation(fields: [productoId], references: [id], onDelete: SetNull)

  productoNombre String? @map("producto_nombre") @db.VarChar(255)
  cantidadM2  Decimal  @map("cantidad_m2") @db.Decimal(12, 2)
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(10, 2)
  subtotal    Decimal  @db.Decimal(12, 2)

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([facturaId])
  @@index([productoId])
  @@map("facturas_items")
}

model InventarioMovimiento {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  productoId  String   @map("producto_id") @db.Uuid
  producto    Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  tipo        String   @db.VarChar(50)
  cantidad    Decimal  @db.Decimal(12, 2)
  stockAntes  Decimal  @map("stock_antes") @db.Decimal(12, 2)
  stockDespues Decimal @map("stock_despues") @db.Decimal(12, 2)

  referenciaTipo String? @map("referencia_tipo") @db.VarChar(50)
  referenciaId   String? @map("referencia_id") @db.Uuid
  motivo       String?  @db.Text

  usuarioId    String?  @map("usuario_id") @db.Uuid
  usuario      Usuario? @relation(fields: [usuarioId], references: [id])

  ipAddress   String?  @map("ip_address") @db.Inet
  fechaMovimiento DateTime @default(now()) @map("fecha_movimiento") @db.Timestamptz

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([productoId])
  @@index([tipo])
  @@index([fechaMovimiento])
  @@index([usuarioId])
  @@map("inventario_movimientos")
}

model Auditoria {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  usuarioId   String?  @map("usuario_id") @db.Uuid
  usuario     Usuario? @relation(fields: [usuarioId], references: [id])

  tablaAfectada String @map("tabla_afectada") @db.VarChar(100)
  registroId    String @map("registro_id") @db.Uuid
  accion        String @db.VarChar(50)

  datosAntes    Json?  @map("datos_antes") @db.JsonB
  datosDespues  Json?  @map("datos_despues") @db.JsonB

  ipAddress     String? @map("ip_address") @db.Inet
  userAgent     String? @map("user_agent") @db.Text

  fechaAccion   DateTime @default(now()) @map("fecha_accion") @db.Timestamptz
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tablaAfectada])
  @@index([usuarioId])
  @@index([fechaAccion])
  @@index([accion])
  @@map("auditoria")
}

model Configuracion {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clave     String   @unique @db.VarChar(100)
  valor     String?  @db.VarChar(500)
  tipo      String?  @db.VarChar(50)

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedByUser Usuario? @relation(fields: [updatedBy], references: [id])

  @@map("configuracion")
}
