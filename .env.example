# Supabase API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase Database Connection (para setup inicial)
# Obtén estos valores de: Supabase Dashboard → Settings → Database → Connection string
DATABASE_URL=postgresql://postgres.your-project:[PASSWORD]@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-project:[PASSWORD]@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# App
NEXT_PUBLIC_APP_NAME=Beraca Inventarios
NEXT_PUBLIC_ADMIN_WHATSAPP=+573001234567

# Environment
NODE_ENV=development
